{
  "name": "pear-tv",
  "appName": "Pear TV",
  "version": "0.4.0",
  "description": "YouTube Music on Samsung TVs through TizenBrew, with Samsung remote control navigation. A TV conversion of Pear Desktop with no plugins.",
  "packageType": "mods",
  "websiteURL": "https://music.youtube.com",
  "main": "userScript.js",
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackNext",
    "MediaTrackPrevious",
    "ChannelUp",
    "ChannelDown"
  ],
  "files": [
    "userScript.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "tizenbrew",
    "tizen",
    "samsung",
    "tv"
  ],
  "license": "MIT"
}
